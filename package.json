{
  "name": "tycho",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tycho/web dev",
    "build": "pnpm --filter @tycho/web build",
    "start": "pnpm --filter @tycho/web start",
    "test": "pnpm --filter @tycho/web test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @tycho/web db:generate",
    "db:migrate": "pnpm --filter @tycho/web db:migrate"
  }
}
