# Copy to apps/web/.env.local for `pnpm dev`, or to .env for `docker compose up`.

# Postgres. The docker compose database listens on 127.0.0.1:55432.
DATABASE_URL=postgres://tycho:tycho@127.0.0.1:55432/tycho

# Where people reach the app. Used for the CSRF origin check; set it behind a proxy.
APP_URL=http://localhost:4310

# Mail through Resend (https://resend.com). Leave RESEND_API_KEY empty for dev
# mode: sign-in codes print to the server console and no mail is sent.
RESEND_API_KEY=
MAIL_FROM=Tycho <noreply@example.com>

# Set to 0 to skip running database migrations when the server starts.
# MIGRATE_ON_START=1
